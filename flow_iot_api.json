    {
        "id": "a1ada8cbf620ce89",
        "type": "function",
        "z": "74f28683955c541f",
        "name": "Validasi & Publish",
        "func": "var body = msg.payload || {};\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'device dan action wajib diisi' };\n    return [msg, null];\n}\nvar action = String(body.action).toLowerCase();\nif (action !== 'on' && action !== 'off') {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'action harus on atau off' };\n    return [msg, null];\n}\nvar cmd = { device: body.device, action: action };\nvar mqttMsg = { topic: 'iot/kontrol', payload: cmd };\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Perintah terkirim', sent: cmd };\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
