        "func": "var data = flow.get('lastSensor') || { suhu: null, kelembaban: null, timestamp: null };\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    threshold: flow.get('threshold'),\n    server_time: new Date().toISOString()\n};\nreturn msg;",
