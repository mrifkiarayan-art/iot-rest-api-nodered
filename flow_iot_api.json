        "id": "bac54cfa70eaa7e5",
        "type": "function",
        "z": "74f28683955c541f",
        "name": "Set API Key & Threshold",
        "func": "global.set('apiKey', 'iot-kampus-2026');\nif (flow.get('threshold') === undefined) { flow.set('threshold', 30); }\nif (!flow.get('alerts')) { flow.set('alerts', []); }\nnode.status({fill: 'green', shape: 'dot', text: 'siap, threshold=' + flow.get('threshold')});\nreturn null;",
