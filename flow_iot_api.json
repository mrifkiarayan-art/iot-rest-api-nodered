        "id": "a5f76f89a73e7acc",
        "type": "function",
        "z": "74f28683955c541f",
        "name": "Cek API Key",
        "func": "var KEY = global.get('apiKey');\nvar sent = (msg.req && msg.req.headers) ? msg.req.headers['x-api-key'] : undefined;\nif (!KEY || sent !== KEY) {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'API key tidak valid. Sertakan header X-API-Key.' };\n    node.status({fill: 'red', shape: 'ring', text: '401 ditolak'});\n    return [null, msg];\n}\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
