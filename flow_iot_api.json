    {
        "id": "f5f11608d1dd867e",
        "type": "function",
        "z": "74f28683955c541f",
        "name": "Threshold GET/PUT",
        "func": "if (msg.req.method === 'PUT') {\n    var body = msg.payload || {};\n    var val = Number(body.max);\n    if (body.max === undefined || body.max === null || body.max === '' || isNaN(val)) {\n        msg.statusCode = 400;\n        msg.payload = { status: 'error', message: 'Field max (angka) wajib diisi' };\n        return msg;\n    }\n    flow.set('threshold', val);\n    msg.statusCode = 200;\n    msg.payload = { status: 'success', message: 'Batas suhu diperbarui', threshold: val };\n    return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', threshold: flow.get('threshold') };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 560,
        "wires": [
            [
                "554fdabc042c5f79"
            ]
        ]
