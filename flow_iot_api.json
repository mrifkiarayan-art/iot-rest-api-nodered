    {
        "id": "bb68a149fedc70af",
        "type": "mqtt in",
        "z": "74f28683955c541f",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 200,
        "wires": [
            [
                "ff4b368963e2b7fa"
            ]
        ]
    },
    {
        "id": "ff4b368963e2b7fa",
        "type": "function",
        "z": "74f28683955c541f",
        "name": "Proses Data Sensor",
        "func": "var data = msg.payload;\nif (typeof data !== 'object' || data === null) {\n    node.warn('Payload sensor bukan JSON');\n    return null;\n}\ndata.received = new Date().toISOString();\nvar threshold = flow.get('threshold');\nif (threshold === undefined) { threshold = 30; }\ndata.alert = (typeof data.suhu === 'number') && data.suhu > threshold;\nflow.set('lastSensor', data);\n\n// Output 1: broadcast ke WebSocket\nvar wsMsg = { payload: { type: 'sensor', data: data, threshold: threshold } };\n\n// Output 2: simpan ke SQLite\nvar dbMsg = { params: {\n    $suhu: data.suhu,\n    $kelembaban: data.kelembaban,\n    $timestamp: data.timestamp,\n    $received: data.received\n} };\n\n// Output 3: notifikasi jika suhu melewati batas\nvar alertMsg = null;\nif (data.alert) {\n    var info = {\n        waktu: data.received,\n        suhu: data.suhu,\n        batas: threshold,\n        pesan: 'Suhu ' + data.suhu + ' C melewati batas ' + threshold + ' C'\n    };\n    var alerts = flow.get('alerts') || [];\n    alerts.push(info);\n    if (alerts.length > 50) { alerts.shift(); }\n    flow.set('alerts', alerts);\n    alertMsg = { topic: 'iot/alert', payload: info };\n    node.status({fill: 'red', shape: 'dot', text: 'ALERT ' + data.suhu});\n} else {\n    node.status({fill: 'green', shape: 'dot', text: 'normal ' + data.suhu});\n}\nreturn [wsMsg, dbMsg, alertMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 200,
        "wires": [
